# Supabase project credentials.
# Copy this file to .env.local and fill in the values from your Supabase project.
# When these are omitted the app runs against a local, file-backed demo
# workspace so the interface can be explored without a database.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Use either the legacy anon key or the newer publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Server-only. Never expose this to the browser.
# The service role key is used by the optional seed script.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Prisma migrations and the sample seed.
# DATABASE_URL uses the Supabase session pooler; DIRECT_URL uses the direct
# connection. Both are server-only and must never be exposed to the browser.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
